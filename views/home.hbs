<div class="shell">
  <header class="hero">
    <div>
      <p class="eyebrow">Server-rendered portfolio dashboard</p>
      <h1>{{pageTitle}}</h1>
      <p class="subtitle">Node.js handles price refreshes, CSV imports, and the portfolio snapshot rendered into Handlebars.</p>
    </div>
    <div class="toolbar">
      <button id="refreshPricesButton" class="button button-secondary" type="button">
        <span id="rfIcon">↻</span>
        Refresh Prices
      </button>
      <button id="openImportButton" class="button button-primary" type="button">Import CSV</button>
    </div>
  </header>

  <section class="stats-grid">
    <article class="stat-card">
      <span class="stat-label">Total Value</span>
      <strong class="stat-value neu" id="sTotal">{{summary.totalValue}}</strong>
    </article>
    <article class="stat-card compact">
      <span class="stat-label">Equities</span>
      <strong class="stat-value" id="sCnt">{{summary.equities}}</strong>
    </article>
    <article class="stat-card compact">
      <span class="stat-label">Sectors</span>
      <strong class="stat-value" id="sSec">{{summary.sectors}}</strong>
    </article>
    <article class="stat-card">
      <span class="stat-label">Annual Dividends</span>
      <strong class="stat-value pos" id="sDivs">{{summary.annualDividends}}</strong>
    </article>
  </section>

  <section class="panel">
    <div class="tabs" role="tablist" aria-label="Dashboard views">
      <button class="tab-button active" type="button" data-tab="holdings">Holdings</button>
      <button class="tab-button" type="button" data-tab="charts">Charts</button>
      <button class="tab-button" type="button" data-tab="sectors">Sectors</button>
      <button class="tab-button" type="button" data-tab="expenses">Expenses</button>
    </div>

    <div class="status-row">
      <span id="statusPill" class="status-pill ok">Ready</span>
      <span id="statusText">Server-rendered data loaded.</span>
    </div>

    <div id="tab-holdings" class="tab-panel active">
      {{#each sections}}
        <section class="section-card">
          <div class="section-header">
            <span class="section-badge" style="background: {{color}}22; color: {{color}}; border-color: {{color}}44;">{{name}}</span>
            <span class="section-total">{{totalValue}}</span>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Ticker</th>
                  <th>Name</th>
                  <th>Shares</th>
                  <th>Current Value</th>
                  <th>Price</th>
                  <th>P/B</th>
                  <th>Div Yield</th>
                </tr>
              </thead>
              <tbody>
                {{#each rows}}
                  <tr>
                    <td class="ticker">{{#if ticker}}{{ticker}}{{else}}—{{/if}}</td>
                    <td>
                      <div>{{name}}</div>
                      {{#if note}}<div class="note">{{note}}</div>{{/if}}
                    </td>
                    <td>{{shares}}</td>
                    <td>{{currentValue}}</td>
                    <td>{{price}}</td>
                    <td class="{{pbClass}}">{{pb}}</td>
                    <td class="{{dividendYieldClass}}">{{dividendYield}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </section>
      {{/each}}

      <section class="section-card">
        <div class="section-header">
          <span class="section-badge" style="background: #38bdf822; color: #38bdf8; border-color: #38bdf844;">Commodity Relative Value Ranking</span>
          <span class="section-total">{{commodityRatios.rankings.length}} commodities ranked using {{commodityRatios.lookbackLabel}} history</span>
        </div>
        <div class="section-header">
          <label class="field-label" for="commodityLookbackSelect">Ranking lookback</label>
          <select id="commodityLookbackSelect" class="input-select" aria-label="Commodity ranking lookback">
            {{#each commodityRatios.lookbackOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Rank</th>
                <th>Ticker</th>
                <th>Yahoo Symbol</th>
                <th>Name</th>
                <th>Current Price</th>
                <th>Historically Cheap Vs</th>
              </tr>
            </thead>
            <tbody id="commodity-rankings-body">
              {{#each commodityRatios.rankings}}
                <tr>
                  <td>{{rank}}</td>
                  <td class="ticker">{{displayTicker}}</td>
                  <td>{{yahooTicker}}</td>
                  <td>{{name}}</td>
                  <td>{{currentPrice}}</td>
                  <td>{{comparisonSummary}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div id="tab-charts" class="tab-panel">
      <div class="chart-grid">
        <article class="chart-card"><h2>Allocation by Sector</h2><canvas id="cPie"></canvas></article>
        <article class="chart-card"><h2>Top Holdings</h2><canvas id="cTop"></canvas></article>
        <article class="chart-card"><h2>Price-to-Book</h2><canvas id="cPB"></canvas></article>
      </div>
    </div>

    <div id="tab-sectors" class="tab-panel">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Sector</th>
              <th>Value</th>
              <th>Allocation</th>
              <th>Holdings</th>
            </tr>
          </thead>
          <tbody>
            {{#each sectors}}
              <tr>
                <td>
                  <span class="sector-key" style="background: {{color}};"></span>
                  {{name}}
                  {{#if isStatic}}<span class="muted small">(static)</span>{{/if}}
                </td>
                <td>{{value}}</td>
                <td>
                  <div class="allocation-cell">
                    <div class="allocation-track">
                      <div class="allocation-bar" style="width: {{allocationBarWidth}}%; background: {{color}};"></div>
                    </div>
                    <span>{{allocationPct}}</span>
                  </div>
                </td>
                <td>{{holdings}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    <div id="tab-expenses" class="tab-panel">
      <div class="expense-toolbar">
        <button id="openExpenseImportButton" class="button button-primary" type="button">Import Expense CSV</button>
      </div>

      <div class="expense-summary">
        <div class="stat-row">
          <div class="stat-item">
            <span class="stat-label">Total Spent</span>
            <strong class="stat-value" id="expenseTotalSpent">{{expenses.totalSpent}}</strong>
          </div>
          <div class="stat-item">
            <span class="stat-label">Transactions</span>
            <strong class="stat-value" id="expenseTransactionCount">{{expenses.transactionCount}}</strong>
          </div>
          <div class="stat-item">
            <span class="stat-label">Date Range</span>
            <strong class="stat-value" id="expenseDateRange">{{expenses.dateRange}}</strong>
          </div>
        </div>
      </div>

      <div class="expense-chart-container">
        <h3>Spending by Category</h3>
        <canvas id="expenseChart" width="400" height="400"></canvas>
      </div>

      <div class="transaction-controls">
        <div class="filter-group">
          <label for="categoryFilter">Category:</label>
          <select id="categoryFilter">
            <option value="">All Categories</option>
            {{#each expenses.categories}}
              <option value="{{name}}">{{name}} ({{count}})</option>
            {{/each}}
          </select>
        </div>
        <div class="filter-group">
          <label for="monthFilter">Month:</label>
          <select id="monthFilter">
            <option value="">All Months</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="yearFilter">Year:</label>
          <select id="yearFilter">
            <option value="">All Years</option>
          </select>
        </div>
      </div>

      <div class="table-wrap">
        <table id="transactionTable">
          <thead>
            <tr>
              <th>Date</th>
              <th>Description</th>
              <th>Category</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Memo</th>
            </tr>
          </thead>
          <tbody id="transactionTableBody">
            {{#each expenses.transactions}}
              <tr data-category="{{category}}" data-transaction-date="{{transactionDate}}">
                <td>{{transactionDate}}</td>
                <td>{{description}}</td>
                <td>
                  <span class="category-badge" style="background: {{categoryColor}}22; color: {{categoryColor}}; border-color: {{categoryColor}}44;">
                    {{category}}
                  </span>
                </td>
                <td>{{type}}</td>
                <td class="{{amountClass}}">{{amount}}</td>
                <td class="memo">{{memo}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<div id="expenseImportModal" class="modal hidden" aria-hidden="true">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="expenseImportTitle">
    <div class="modal-header">
      <div>
        <p class="eyebrow">Import Chase transactions</p>
        <h2 id="expenseImportTitle">Expense CSV Import</h2>
      </div>
      <button id="closeExpenseImportButton" class="icon-button" type="button" aria-label="Close expense import dialog">✕</button>
    </div>

    <div class="tabs compact-tabs" role="tablist" aria-label="Expense import source selector">
      <button id="expenseImportTextTab" class="tab-button active" type="button">Paste CSV</button>
      <button id="expenseImportFileTab" class="tab-button" type="button">Upload File</button>
    </div>

    <div id="expenseImportTextPanel" class="import-panel active">
      <label class="field-label" for="expenseCsvInput">CSV content</label>
      <textarea id="expenseCsvInput" rows="12" placeholder="Paste your Chase CSV export here"></textarea>
    </div>

    <div id="expenseImportFilePanel" class="import-panel hidden">
      <label class="field-label" for="expenseCsvFile">CSV file</label>
      <input id="expenseCsvFile" type="file" accept=".csv,text/csv" />
    </div>

    <div class="modal-footer">
      <div>
        <span id="expenseImportStatusPill" class="status-pill ok">Ready</span>
        <span id="expenseImportStatus">Choose a CSV source to import.</span>
      </div>
      <button id="doExpenseImportButton" class="button button-primary" type="button">Import Expenses</button>
    </div>
  </div>
</div>

<div id="importModal" class="modal hidden" aria-hidden="true">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="importTitle">
    <div class="modal-header">
      <div>
        <p class="eyebrow">Import spreadsheet data</p>
        <h2 id="importTitle">Portfolio CSV Import</h2>
      </div>
      <button id="closeImportButton" class="icon-button" type="button" aria-label="Close import dialog">✕</button>
    </div>

    <div class="tabs compact-tabs" role="tablist" aria-label="Import source selector">
      <button id="importTextTab" class="tab-button active" type="button">Paste CSV</button>
      <button id="importFileTab" class="tab-button" type="button">Upload File</button>
    </div>

    <div id="importTextPanel" class="import-panel active">
      <label class="field-label" for="csvInput">CSV content</label>
      <textarea id="csvInput" rows="12" placeholder="Paste your spreadsheet export here"></textarea>
    </div>

    <div id="importFilePanel" class="import-panel hidden">
      <label class="field-label" for="csvFile">CSV file</label>
      <input id="csvFile" type="file" accept=".csv,text/csv" />
    </div>

    <div class="modal-footer">
      <div>
        <span id="importStatusPill" class="status-pill ok">Ready</span>
        <span id="importStatus">Choose a CSV source to import.</span>
      </div>
      <button id="doImportButton" class="button button-primary" type="button">Import Portfolio</button>
    </div>
  </div>
</div>
